# ============================================================
# 企业知识库智能分析 Agent —— 环境变量
# ============================================================

# ---------- LLM：Agent 推理、路由、核查、生成 ----------
LLM_PROVIDER=dashscope
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=sk-xxx
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ---------- Embedding：文档与查询向量化（输出 1024 维） ----------
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# ---------- 向量库 ----------
CHROMA_PATH=./data/chroma_db
CHROMA_COLLECTION=enterprise_kb

# ---------- 检索 ----------
TOP_K=10
RRF_K=60

# ---------- 文档库 ----------
DOCS_DIR=./data/docs

# ---------- Agent 自纠正循环 ----------
MAX_RETRY=3
VERIFIER_MODEL=qwen3.6-flash

# ---------- MCP ----------
MCP_ENABLED=true
MCP_SERVERS=chroma,filesystem
MCP_TIMEOUT=30
MCP_START_TIMEOUT=60
MCP_PING_TIMEOUT=5

# ---------- 外部搜索 ----------
# 未配置时 web_search 工具会返回明确的「未启用」错误。
SEARCH_PROVIDER=tavily
SEARCH_API_BASE=
SEARCH_API_KEY=
SEARCH_TIMEOUT=20

# ---------- 多轮会话 ----------
MEMORY_ENABLED=true

# ---------- LLM-as-judge ----------
JUDGE_MODEL=deepseek-v4-pro
