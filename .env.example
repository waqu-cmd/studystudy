# ============================================================
# 企业知识库智能分析 Agent —— 环境变量
# 用法：复制为同目录的 .env 并填入真实值。.env 已被 .gitignore 忽略。
# 命名规则：与 app/core/config.py 中 Settings 的字段名一一对应（小写字段 ↔ 大写变量）。
# ============================================================

# ---------- LLM：Agent 推理、路由、核查、生成 ----------
# 阿里云百炼平台，通过 OpenAI 兼容接口调用 DeepSeek 模型
LLM_PROVIDER=dashscope
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=sk-xxx
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ---------- Embedding：文档与查询向量化（输出 1024 维） ----------
# 阿里云百炼的 Embedding 模型，base_url 与 LLM 相同
EMBEDDING_PROVIDER=dashscope
# 留空则自动复用上面的 LLM_API_KEY
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# ---------- 向量库 ----------
CHROMA_PATH=./data/chroma_db
CHROMA_COLLECTION=enterprise_kb

# ---------- 检索 ----------
TOP_K=10
RRF_K=60

# ---------- 文档库 ----------
DOCS_DIR=./data/docs

# ---------- Agent 自纠正循环 ----------
MAX_RETRY=3

# ---------- LLM-as-judge（留空则复用 LLM_* 配置） ----------
JUDGE_MODEL=

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- 可选: LangSmith 追踪 ----------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-kb-agent
