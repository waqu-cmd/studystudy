# ============================================================
# 企业知识库智能分析 Agent —— 环境变量
# ============================================================

# ---------- LLM：Agent 推理、路由、核查、生成 ----------
# 阿里云百炼平台，通过 OpenAI 兼容接口调用 DeepSeek 模型
LLM_PROVIDER=dashscope
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=sk-xxx
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ---------- Embedding：文档与查询向量化（输出 1024 维） ----------
# 阿里云百炼的 Embedding 模型，base_url 与 LLM 相同
EMBEDDING_PROVIDER=dashscope
# 留空则自动复用上面的 LLM_API_KEY
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
# 单次请求最多提交多少条文本。text-embedding-v4 的硬上限是 10，超过直接报 400。
EMBEDDING_BATCH_SIZE=10

# ---------- 向量库 ----------
CHROMA_PATH=./data/chroma_db
CHROMA_COLLECTION=enterprise_kb

# ---------- 检索 ----------
TOP_K=10
RRF_K=60

# ---------- 文档库 ----------
DOCS_DIR=./data/docs

# ---------- Agent 自纠正循环 ----------
MAX_RETRY=3
# 阶段 3：核查器（verifier）专用模型。留空则复用 LLM_MODEL。
# 核查是「判断题 + 结构化输出」，比生成任务简单，可换成更便宜的小模型来控成本。
VERIFIER_MODEL=

# ---------- MCP ----------
# 总开关。置 false 时检索退回进程内直连（阶段 3 行为），用于 A/B 对比与故障回退。
MCP_ENABLED=true
# 启用的 Server，逗号分隔。可选 chroma / filesystem / search。
# search 需要外部检索服务凭据，未配置时不必启用，可省一个子进程的启动成本。
MCP_SERVERS=chroma,filesystem
# 单次工具调用超时（秒）。检索内含一次 embedding 网络请求，不宜过短。
MCP_TIMEOUT=30
# 启动时与全部 Server 握手的总超时（秒）。真实 Server 需 import chromadb，冷启动较慢。
MCP_START_TIMEOUT=60
# 健康检查单次 ping 超时（秒）。
MCP_PING_TIMEOUT=5

# ---------- 外部搜索 ----------
# 未配置时 web_search 工具会返回明确的「未启用」错误，而不是空结果冒充「没搜到」。
SEARCH_PROVIDER=tavily
SEARCH_API_BASE=
SEARCH_API_KEY=
SEARCH_TIMEOUT=20

# ---------- 多轮会话（阶段 5） ----------
# 置 true 时图编译时挂 MemorySaver，session_id 作为 thread_id 保留会话状态。
# 置 false 退回无状态（每轮独立），用于回归对照与无状态部署。
MEMORY_ENABLED=true

# ---------- LLM-as-judge（留空则复用 LLM_* 配置） ----------
JUDGE_MODEL=

# ---------- 日志 ----------
LOG_LEVEL=INFO
